<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g05_prii3_eurobot</name>
  <version>0.0.0</version>
  <description>Sprint 4: navegación en el tablero Eurobot (simulación y JetBot real)</description>
  <maintainer email="jgarrod3@upv.edu.es">juan</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Mundo, mapa y launch de Nav2 del tablero -->
  <exec_depend>eurobot_gazebo</exec_depend>
  <!-- jetbot_pro_ros2 (driver Waveshare) solo existe en el robot -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
