    <link name='base_footprint'>
      <self_collide>0</self_collide>
      <!-- Inercia despreciable. Sin <inertial>, Gazebo pone 1 kg y 1 kg·m² por eje (13 veces
           la inercia del chasis): el robot seguía girando como un volante al mandarle
           velocidad cero, con las ruedas patinando. -->
